# Proxmox Configuration
PROXMOX_HOSTS=primary,secondary,ollama-node
PROXMOX_PRIMARY_HOST=192.168.1.100
PROXMOX_PRIMARY_PORT=8006
PROXMOX_PRIMARY_USER=root@pam
PROXMOX_PRIMARY_PASSWORD=your_password
PROXMOX_PRIMARY_VERIFY_SSL=true

# Secondary node (optional)
PROXMOX_SECONDARY_HOST=192.168.1.101
PROXMOX_SECONDARY_PORT=8006
PROXMOX_SECONDARY_USER=root@pam
PROXMOX_SECONDARY_PASSWORD=your_password
PROXMOX_SECONDARY_VERIFY_SSL=true

# Ollama node (optional)
PROXMOX_OLLAMA_HOST=192.168.1.102
PROXMOX_OLLAMA_PORT=8006
PROXMOX_OLLAMA_USER=root@pam
PROXMOX_OLLAMA_PASSWORD=your_password
PROXMOX_OLLAMA_VERIFY_SSL=true

# Dashboard Configuration
DASHBOARD_PORT=8000
DASHBOARD_HOST=0.0.0.0
REFRESH_INTERVAL=30

# Service Health Check
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3